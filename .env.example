# VPS: replace these before the first start. DOMAIN has no https:// prefix or trailing slash.
DOMAIN=pickleball.example.com
APP_ORIGIN=https://pickleball.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PASSWORD
# Persistent database and uploads. Docker Compose sets /app/data automatically.
DATA_DIR=./data
# Set only when the app is reachable through the supplied reverse proxy.
TRUST_PROXY=1
